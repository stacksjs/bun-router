{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "bun-router": [
        "./packages/bun-router/src/*"
      ]
    },
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": [
    "**/src/**/*",
    "**/bin/**/*",
    "**/test/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*",
    "**/dist/**/*",
    "**/pantry/**/*",
    // Checked by `tsconfig.registry-types.json` instead. Its `declare module`
    // augmentation is global, so including it here would narrow every action
    // path and middleware alias in the whole compilation - and the behaviour
    // most applications actually see, the un-augmented one, would go unchecked.
    // Named exactly, not globbed: `registry-fallback-typing.test-d.ts` is the
    // file that proves the un-augmented case and belongs in THIS project.
    "**/registry-typing.test-d.ts"
  ]
}
